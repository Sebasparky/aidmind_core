# AidMind frontend environment (Vite). Copy to .env.local and fill in.
# All VITE_* values are shipped to the browser; never put a service-role key here.
# Values below are placeholders, not real credentials.

# Supabase project. Local stack: URL http://127.0.0.1:54321 and the anon key printed by `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
VITE_SUPABASE_PROJECT_ID=local

# Enables developer panels (role toggle, RLS check, retrieval eval). Keep false outside local dev.
VITE_DEV_MODE=false

# Reviewer model source. Unset = live local Ollama path (localhost:11434, llama3).
# "fixture" = labelled fixture replay used by the demo stack (no model call); never deploy a build made with it.
# VITE_REVIEWER_MODEL_SOURCE=fixture
